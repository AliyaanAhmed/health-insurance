{
  "name": "health-insurance-spa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src scripts tests playwright.config.ts vite.config.ts",
    "preview": "vite preview",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "test:ui": "playwright test",
    "format": "prettier --write src scripts tests playwright.config.ts vite.config.ts DESIGN.md UX-CONTRACT.md docs/health-field-map.md",
    "format:check": "prettier --check src scripts tests playwright.config.ts vite.config.ts DESIGN.md UX-CONTRACT.md docs/health-field-map.md"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
